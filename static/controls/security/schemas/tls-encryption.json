{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.company.com/security/tls-encryption.json",
    "title": "TLS Encryption Requirement",
    "description": "Defines the required configuration for TLS encryption of service-to-service communications",
    "type": "object",
    "properties": {
        "protocol": {
            "type": "string",
            "const": "TLS",
            "description": "Transport security protocol - must be TLS"
        },
        "version": {
            "type": "string",
            "enum": ["1.2", "1.3"],
            "description": "Minimum TLS version required. 1.3 is preferred."
        },
        "cipher-suites": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "description": "IANA cipher suite name"
            },
            "description": "Allowed TLS cipher suites in order of preference"
        },
        "certificate-authority": {
            "type": "string",
            "description": "Name or identifier of the trusted certificate authority"
        },
        "cert-rotation-days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "Certificate rotation interval in days"
        }
    },
    "required": ["protocol", "version", "cipher-suites", "certificate-authority", "cert-rotation-days"],
    "additionalProperties": false
}
