{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/controls/node-control-standard.json",
  "title": "Node Control Standard",
  "description": "Requires nodes to define a controls section that includes a session-protection control.",
  "allOf": [
    { "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node" },
    {
      "type": "object",
      "properties": {
        "controls": {
          "type": "object",
          "properties": {
            "session-protection": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "description": "Human-readable description of the session protection requirement."
                },
                "requirements": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object"
                  },
                  "description": "At least one requirement entry must be supplied for the session protection control."
                }
              },
              "required": ["description", "requirements"]
            }
          },
          "required": ["session-protection"]
        }
      },
      "required": ["controls"]
    }
  ]
}
