{
  "name": "calm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:getfile",
    "typecheck:app": "tsc --noEmit",
    "typecheck:getfile": "tsc -p getfile/tsconfig.json --noEmit",
    "getfile:build": "tsc -p getfile/tsconfig.json",
    "getfile": "npm run getfile:build && node getfile/dist/main.js",
    "test:getfile": "npm run getfile:build && node --test getfile/tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
