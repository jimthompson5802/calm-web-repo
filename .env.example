CALM_PUBLIC_HOST=my-calm.repo
# Stack bootstrap
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# Browser/proxy stack
OAUTH2_PROXY_CLIENT_SECRET=replace-with-a-generated-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-a-32-character-cookie-secret
# Direct-url machine client
KEYCLOAK_DIRECT_URL_CLIENT_SECRET=replace-with-a-generated-machine-client-secret
# Test-user bootstrap data
KEYCLOAK_TEST_USER_USERNAME=local-user
KEYCLOAK_TEST_USER_EMAIL=local-user@example.com
KEYCLOAK_TEST_USER_PASSWORD=change-me-user-password
